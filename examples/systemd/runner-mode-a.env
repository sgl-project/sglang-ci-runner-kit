# Mode A: each job runs on this host in a fresh `docker run --rm` container.
BROKER_URL=https://<broker endpoint from sglang>
VENDOR=<vendor>
KID=<vendor>-host01-2026-11
KEY_PATH=/etc/sglang-ci/<vendor>-host01-2026-11.key
RUNNER_LABEL=<vendor>-pr
RUNNER_HOST=host01
RUNNER_MODE=container
RUNNER_IMAGE=<runner image with actions/runner, ./run.sh in its workdir>
DOCKER_ARGS=--device /dev/<accel> -v /data/cache:/cache:ro
