# Mode B: the runner is a thin client that hands the job to your own scheduler.
BROKER_URL=https://<broker endpoint from sglang>
VENDOR=<vendor>
KID=<vendor>-host01-2026-11
KEY_PATH=/etc/sglang-ci/<vendor>-host01-2026-11.key
RUNNER_LABEL=<vendor>-pr
RUNNER_HOST=host01
RUNNER_MODE=host
RUNNER_DIR=/opt/sglang-ci/actions-runner
RUNNER_USER=sglang-runner
